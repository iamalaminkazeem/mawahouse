# --- Database (Neon Postgres) ---
# Use the "pooled" connection string from your Neon dashboard for DATABASE_URL
# (used at runtime), and the "direct" connection string for DIRECT_URL
# (used by Prisma for migrations/db push). Neon shows both on the connection
# details page. Include ?sslmode=require on both.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/mawahouse?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/mawahouse?sslmode=require"

# --- NextAuth ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-domain.com"

# --- ImageKit (image uploads for gallery/menu photos) ---
# From your ImageKit dashboard → Developer Options
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"

# --- Seed script (first admin login — change password after first login!) ---
SEED_ADMIN_EMAIL="admin@mawahouse.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
