generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  section   String
  sortOrder Int        @default(0)
  visible   Boolean    @default(true)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  available   Boolean     @default(true)
  featured    Boolean     @default(false)
  sortOrder   Int         @default(0)
  dietaryTags String[]    @default([])
  allergens   String[]    @default([])
  notes       String?
  sizes       Json?
  addOns      AddOn[]
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model AddOn {
  id         String   @id @default(cuid())
  name       String
  price      Float
  available  Boolean  @default(true)
  sortOrder  Int      @default(0)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Special {
  id          String    @id @default(cuid())
  name        String
  description String?
  price       Float?
  imageUrl    String?
  startDate   DateTime?
  endDate     DateTime?
  active      Boolean   @default(true)
  featured    Boolean   @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BuffetEntry {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float?
  imageUrl    String?
  days        String[] @default([])
  startTime   String?
  endTime     String?
  available   Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  category  String   @default("other")
  featured  Boolean  @default(false)
  hidden    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

enum OrderType {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  RECEIVED
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

model Order {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique
  customerName         String
  customerPhone        String
  customerEmail        String?
  orderType            OrderType
  deliveryAddress      String?
  deliveryCity         String?
  deliveryState        String?
  deliveryZip          String?
  deliveryInstructions String?
  pickupNotes          String?
  items                OrderItem[]
  subtotal             Float
  deliveryFee          Float       @default(0)
  tax                  Float       @default(0)
  total                Float
  status               OrderStatus @default(RECEIVED)
  specialInstructions  String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model OrderItem {
  id                  String           @id @default(cuid())
  orderId             String
  order               Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId          String?
  menuItem            MenuItem?        @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  itemNameSnapshot    String
  priceSnapshot       Float
  quantity            Int              @default(1)
  subtotal            Float
  specialInstructions String?
  addOns              OrderItemAddon[]
  createdAt           DateTime         @default(now())
}

model OrderItemAddon {
  id            String    @id @default(cuid())
  orderItemId   String
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  nameSnapshot  String
  priceSnapshot Float
  quantity      Int       @default(1)
}

model OrderCounter {
  id      String @id @default("main")
  lastSeq Int    @default(0)
}

model SiteSettings {
  id                  String   @id @default("main")

  restaurantName      String   @default("MaWa House")
  tagline             String   @default("Taste Africa. Feel at Home.")
  address             String   @default("524 Main St, Suite B, Atlanta, GA 30011")
  phone               String   @default("470-815-6319")
  whatsappNumber      String?
  email               String?

  hours               Json     @default("{}")

  heroHeadline        String   @default("Where African Flavor Meets Modern Hospitality")
  heroSubtext         String   @default("Discover a warm and welcoming dining experience inspired by African flavors, culture, and community.")
  heroImageUrl        String?
  heroBadge           String?

  welcomeHeadline     String   @default("Good Food. Great People. Stronger Community.")
  welcomeBody         String?

  aboutHeadline       String?
  aboutBody           String?
  aboutImageUrl       String?

  orderOnlineButtonText String @default("Order Online")
  orderingEnabled      Boolean  @default(true)
  deliveryEnabled      Boolean  @default(false)
  deliveryFee          Float?
  deliveryMinimum      Float?
  deliveryNote         String?
  taxEnabled           Boolean  @default(false)
  taxRate              Float?
  orderReceivedNote    String   @default("Your order has been received and will be reviewed by our team.")

  // Catering Settings
  cateringUrl         String?
  cateringPlatform    String?
  cateringButtonText  String   @default("Inquire for Catering")

  googleMapsUrl       String?
  googleMapsEmbedUrl  String?

  instagramUrl        String?  @default("https://instagram.com/mawahouse_1")
  tiktokUrl           String?  @default("https://tiktok.com/@mawa.house4")
  facebookUrl         String?

  announcementEnabled Boolean  @default(false)
  announcementText    String?

  updatedAt           DateTime @updatedAt
}